{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/:path((?!api/|auth/|assets/|images/|favicon.svg).*)", "destination": "/index.html" }
  ]
}
